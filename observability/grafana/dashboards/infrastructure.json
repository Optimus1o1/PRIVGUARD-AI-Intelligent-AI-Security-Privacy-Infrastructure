      "title": "DB Pool Overflow Count",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "privguard_database_pool_connections{state='overflow'}",
          "legendFormat": "overflow"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
