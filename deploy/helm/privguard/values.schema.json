{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRIVGUARD AI Values Schema",
  "description": "JSON Schema validating PRIVGUARD AI Helm chart configuration",
  "type": "object",
  "required": [
    "database",
    "redis",
    "secrets"
  ],
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "production"
          ]
        },
        "debug": {
          "type": "boolean"
        },
        "failClosedMode": {
          "type": "boolean"
        },
        "maxRequestSizeBytes": {
          "type": "integer",
          "minimum": 1048576
        },
        "corsAllowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "host",
        "database",
        "existingSecret"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string"
        },
        "migrationUser": {
          "type": "string"
        },
        "sslMode": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "host",
        "existingSecret"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "db": {
          "type": "integer",
          "minimum": 0
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaultDeny": {
          "type": "boolean"
        }
      }
    },
    "kms": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "local",
            "aws_kms",
            "gcp_kms",
            "azure_key_vault",
            "vault_transit"
          ]
        },
        "keyId": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        }
      }
    }
  }
}