{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Model Gateway Invocations",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(privguard_gateway_requests_total[5m]))",
          "legendFormat": "invocations/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Pre-flight Policy Block Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(privguard_gateway_blocked_requests_total[5m])) / (sum(rate(privguard_gateway_requests_total[5m])) + 0.0001) * 100",
          "legendFormat": "Blocked %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Upstream Model Latency (P95)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(privguard_gateway_request_duration_seconds_bucket{phase='upstream'}[5m])) by (le)) * 1000",
          "legendFormat": "P95 Upstream (ms)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Inspection Decisions",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(privguard_gateway_response_inspection_total[5m]))",
          "legendFormat": "inspected/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Gateway Requests by Provider & Model",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(privguard_gateway_requests_total[5m])) by (provider, model)",
          "legendFormat": "{{provider}} / {{model}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Blocked Invocations by Security Reason",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(privguard_gateway_blocked_requests_total[5m])) by (reason)",
          "legendFormat": "Blocked: {{reason}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["privguard", "gateway", "ai"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "PRIVGUARD — AI Gateway Telemetry",
  "uid": "privguard-ai-gateway"
}
