# PRIVGUARD AI Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security & Secrets
PRIVGUARD_MASTER_KEY=change-me-in-production-min-32-chars-long-secret
FAIL_CLOSED_MODE=true

# Database (SQLite with WAL mode by default)
DATABASE_URL=sqlite+aiosqlite:///./privguard.db

# Upstream LLM Provider (Optional for proxying)
UPSTREAM_LLM_BASE_URL=https://api.openai.com/v1
UPSTREAM_LLM_API_KEY=

# Privacy & Audit Policies
AUDIT_CONTENT_STORAGE_ENABLED=false
AUDIT_RETENTION_DAYS=90
DEFAULT_POLICY_ACTION_PERSONAL=REDACT
DEFAULT_POLICY_ACTION_CRITICAL=BLOCK

