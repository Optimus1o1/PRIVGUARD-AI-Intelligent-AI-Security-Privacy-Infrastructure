{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Availability (30d SLI)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(privguard_http_requests_total{status_class!~'5xx'}[5m])) / (sum(rate(privguard_http_requests_total[5m])) + 0.0001) * 100",
          "format": "time_series",
          "legendFormat": "Availability %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99.0 },
              { "color": "green", "value": 99.5 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "HTTP Request Throughput",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(privguard_http_requests_total[1m]))",
          "format": "time_series",
          "legendFormat": "req/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "P95 Request Latency",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(privguard_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "format": "time_series",
          "legendFormat": "P95 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Active Canary Verification Status",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "min(privguard_canary_status)",
          "format": "time_series",
          "legendFormat": "All Canaries Nominal"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "CANARY FAILING" }, "1": { "color": "green", "text": "ALL VERIFIED" } }, "type": "value" }
          ]
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "HTTP Traffic Breakdown by Route & Status",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(privguard_http_requests_total[5m])) by (route, status_class)",
          "legendFormat": "{{route}} [{{status_class}}]"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Gateway Latency Percentiles (P50, P95, P99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(privguard_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(privguard_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(privguard_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["privguard", "overview", "production"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "PRIVGUARD — Platform Overview",
  "uid": "privguard-platform-overview"
}
